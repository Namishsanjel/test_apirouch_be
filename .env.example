# Copy this file to .env and fill in real values.
# NEVER commit .env. Generate every secret with: openssl rand -base64 32
# Multiple values (APP_KEYS, CORS_ORIGINS) are comma-separated.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=1337

# Public HTTPS URL of this API (used for absolute URLs, e.g. media). No trailing slash.
PUBLIC_URL=

# Comma-separated list of allowed browser origins (the frontend domains).
# When unset, only local development origins are allowed.
# Example: https://www.example.com,https://example.com
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# App secrets (required; must stay identical across deployments)
# ---------------------------------------------------------------------------
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database
# Local dev: leave DATABASE_CLIENT unset (SQLite at .tmp/data.db).
# Production: DATABASE_CLIENT=postgres (or mysql) and fill the connection vars.
# ---------------------------------------------------------------------------
DATABASE_CLIENT=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
# Set to true when the database connection requires TLS.
DATABASE_SSL=false
# Optional TLS material (paths or PEM) when DATABASE_SSL=true.
DATABASE_SSL_KEY=
DATABASE_SSL_CERT=
DATABASE_SSL_CA=
DATABASE_SSL_CAPATH=
DATABASE_SSL_CIPHER=
DATABASE_SSL_REJECT_UNAUTHORIZED=
# Optional full connection string (takes precedence when set, Postgres).
DATABASE_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# ---------------------------------------------------------------------------
# Uploads
# Local dev: unset (writes to public/uploads).
# Production: absolute path to a persistent folder outside the repo checkout,
# e.g. /var/www/apitours/shared/uploads
# ---------------------------------------------------------------------------
UPLOADS_DIR=

# ---------------------------------------------------------------------------
# Email notifications (contact-submission + trip-request)
# If SMTP_HOST or NOTIFY_EMAIL is missing, notifications are skipped and a
# warning is logged; submissions are still saved.
# ---------------------------------------------------------------------------
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
